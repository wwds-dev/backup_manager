{
  "permissions": {
    "deny": [
      "Bash(*legal_gate.py sign*)",
      "Edit(**/legal/signoff.jsonl)",
      "Write(**/legal/signoff.jsonl)",
      "Bash(*>*signoff.jsonl*)",
      "Bash(*tee*signoff.jsonl*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/docs/foundry/tooling/session_start.py\""
          }
        ]
      }
    ]
  }
}
